# Copernicus Data Space Ecosystem (CDSE) — register at https://dataspace.copernicus.eu/
# Use password grant (public client) or your registered OIDC client credentials.
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
# Optional: override defaults from CDSE docs
# COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
# COPERNICUS_CLIENT_ID=cdse-public

# USGS M2M (Earth Explorer) — register at https://ers.cr.usgs.gov/register
USGS_M2M_USERNAME=
USGS_M2M_PASSWORD=

# NASA Earthdata (for future CMR / LP DAAC flows)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Optional: STAC catalog that requires Bearer token
# STAC_BEARER_TOKEN=
